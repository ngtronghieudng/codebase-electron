{
  "name": "codebase-electron",
  "description": "This template will help you get started with Electron using ElectronForge",
  "version": "0.1.0",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">= 22",
    "pnpm": ">= 10",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "bun": "please-use-pnpm"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "postinstall": "cd node_modules/electron && node install.js",
    "format": "prettier . --write",
    "lint": "eslint . --fix",
    "type-check": "tsc --build --force --noEmit",
    "check-all": "run-p format lint type-check",
    "preinstall": "npx -y only-allow pnpm",
    "prepare": "husky",
    "pre-commit": "lint-staged && validate-branch-name"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm run format",
      "pnpm run lint",
      "git add ."
    ]
  },
  "validate-branch-name": {
    "pattern": "^(feature|bugfix|hotfix|release)/.+|(master)$"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tanstack/react-query": "^5.75.2",
    "antd": "^5.23.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "electron-squirrel-startup": "^1.0.1",
    "i18next": "^24.2.0",
    "js-cookie": "^3.0.5",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.556.0",
    "postcss": "^8.5.6",
    "qs": "^6.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-hook-form-antd": "^1.1.3",
    "react-i18next": "^15.4.0",
    "react-router": "^7.1.1",
    "store2": "^2.14.4",
    "string-template": "^1.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "usehooks-ts": "^3.1.1",
    "uuid": "^11.0.3",
    "yup": "^1.6.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron-forge/plugin-vite": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.18.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/qs": "^6.9.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/string-template": "^1.0.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "electron": "35.4.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-i18next": "^6.1.1",
    "eslint-plugin-perfectionist": "^4.6.0",
    "eslint-plugin-react": "^7.37.3",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "1.77.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-auto-import": "^0.19.0",
    "validate-branch-name": "^1.3.1",
    "vite": "^5.4.19",
    "vite-plugin-svgr": "^4.3.0"
  }
}
